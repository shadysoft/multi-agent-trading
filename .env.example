# MetaTrader 5 Configuration
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server

# Database Configuration
DATABASE_URL=sqlite:///./trading.db
# For PostgreSQL: postgresql://user:password@localhost/trading_db

# Trading Configuration
ENABLE_LIVE_TRADING=False  # Set to True for live trading
ENABLE_PAPER_TRADING=True  # Set to True for paper trading

# Risk Management
MAX_DAILY_LOSS_PERCENT=2.0
MAX_POSITION_SIZE_PERCENT=1.0
MAX_CONCURRENT_TRADES=5

# Dashboard Configuration
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# API Keys (if needed for additional data sources)
ALPHA_VANTAGE_API_KEY=your_api_key_here
POLYGON_API_KEY=your_api_key_here

# Notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
ENABLE_TELEGRAM_ALERTS=False

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ENABLE_EMAIL_ALERTS=False
